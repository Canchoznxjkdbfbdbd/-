# Ключ Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Опциональный второй ключ — один failover при 429/503/сетевом/geo
# GEMINI_API_KEY_2=

# На RU VPS прямые вызовы generativelanguage.googleapis.com дают
# FAILED_PRECONDITION (location). Задайте прокси-origin без хвостового слэша:
# GEMINI_API_ORIGIN=http://127.0.0.1:8080

# Основная модель. По умолчанию — быстрая lite (меньше очередей на free-tier).
GEMINI_MODEL=gemini-3.5-flash-lite

# Запасные модели при 503 / UNAVAILABLE (через запятую).
# Полная цепочка = GEMINI_MODEL + этот список.
# По умолчанию без env: gemini-3.5-flash-lite → gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Опционально: более «тяжёлая» 3.8 (может дольше ждать при нагрузке Google):
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Или вся цепочка сразу:
# GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Сколько повторов на каждую модель при перегрузке (по умолчанию 2 → всего 3 попытки)
# GEMINI_OVERLOAD_RETRIES=2
# Пауза перед первым повтором, мс (дальше удваивается): по умолчанию 800
# GEMINI_OVERLOAD_BACKOFF_MS=800

# Длина ответа (раньше 1024 обрезало текст на полуслове; максимум 8192)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Порт локального сервера
PORT=3000

# Сообщество ВК в футере (один источник правды; можно переопределить)
COMMUNITY_VK_URL=https://vk.ru/ai.nutricode

# ВкусВилл автодиплинк (Admitad): база БЕЗ ulp или с пустым ulp — к ней дописывается &ulp=<urlencoded search URL>.
# Это webmaster-ссылка (kdbov… / admitad), НЕ email-лендинг vkusvill.ru/?utm_… .
# Дефолт в коде = live-оффер из Project store; можно переопределить:
ADMITAD_VKUSVILL_BASE=https://kdbov.com/g/2xtzn37pfe268e100ca0b80ad6f8ae/?erid=2bL9aMPo2e49hMef4phUrdrQCx
ADMITAD_VKUSVILL_ERID=2bL9aMPo2e49hMef4phUrdrQCx
# Промокод для плашки (опционально) лежит в partners.json → vkusvill.promo_code (сейчас VSC7247), не в ulp.

# Важная рыба (vipfish.ru) автодиплинк — тот же ulp-паттерн; webmaster dorinebeaumont.com, НЕ vipfish.ru лендинг.
# Чипы: [[vipfish:название]] / [[ryba:название]]; soft-geo СПб зона в prompt + partners.json.geo.
ADMITAD_VIPFISH_BASE=https://dorinebeaumont.com/g/lqb6l7197z268e100ca094cf89477e/?erid=2bL9aMPo2e49hMef4peVndVUPr
ADMITAD_VIPFISH_ERID=2bL9aMPo2e49hMef4peVndVUPr

# BeFit (letbefit.ru) автодиплинк — webmaster uuwgc.com, НЕ letbefit.ru лендинг.
# Чипы: [[befit:slug]] / [[letbefit:slug]]; ulp = /programmy/{slug}/ или WP ?s=; soft-geo Москва+СПб.
# Промо shortlist — partners.json → befit.promos (плашка promo_code=ADMBF2026).
ADMITAD_BEFIT_BASE=https://uuwgc.com/g/qm29jzxwek268e100ca0fcd3300043/?erid=25H8d7vbP8SRTvJZjHsUpp
ADMITAD_BEFIT_ERID=25H8d7vbP8SRTvJZjHsUpp

# Хваловская вода (hvalwaters.ru) автодиплинк — webmaster xmknb.com, НЕ hvalwaters.ru лендинг.
# Чипы: [[hval:slug]] / [[water:slug]] / [[hvalwaters:slug]]; ulp = /water/{slug}/ или WP ?s=.
# Prefer base без i=3; coupon-ish (i=3) — partners.json → admitad_coupon_base (не для ulp-чипов).
# Soft-geo Москва+СПб.
ADMITAD_HVALWATERS_BASE=https://xmknb.com/g/b0173jl262268e100ca000dcac28d3/?erid=2bL9aMPo2e49hMef4pfVDKbKSL
ADMITAD_HVALWATERS_ERID=2bL9aMPo2e49hMef4pfVDKbKSL

# GrowFood (growfood.pro) автодиплинк — webmaster naiawork.com, НЕ growfood.pro / gf.ru лендинг.
# Чипы: [[growfood:slug]] / [[gf:slug]]; ulp = /new-order/{slug} или каталог #menu-plans (поиска нет).
# Промо shortlist — partners.json → growfood.promos (плашка promo_code=ДВОЙНОЙБОНУС).
# Soft-geo Москва+СПб.
ADMITAD_GROWFOOD_BASE=https://naiawork.com/g/36wusytszy268e100ca0aeb982cd0a/?erid=MvGzQC98w3Z1gMq1kxQwfCfT
ADMITAD_GROWFOOD_ERID=MvGzQC98w3Z1gMq1kxQwfCfT
