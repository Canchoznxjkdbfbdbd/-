# Ключ Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Основная модель (по умолчанию актуальная flash)
GEMINI_MODEL=gemini-3.8-flash

# Запасные модели при 503 / UNAVAILABLE (через запятую).
# Полная цепочка = GEMINI_MODEL + этот список.
# Либо задайте всю цепочку сразу: GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Сколько повторов на каждую модель при перегрузке (по умолчанию 2 → всего 3 попытки)
# GEMINI_OVERLOAD_RETRIES=2
# Пауза перед первым повтором, мс (дальше удваивается): по умолчанию 800
# GEMINI_OVERLOAD_BACKOFF_MS=800

# Длина ответа (раньше 1024 обрезало текст на полуслове; максимум 8192)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Порт локального сервера
PORT=3000

# Ссылка на донат (заглушка до подключения оплаты)
DONATE_URL=#donate
